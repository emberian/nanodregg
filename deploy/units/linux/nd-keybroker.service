# GENERATED by emit-units from Ops/Units.lean and Hosting/BrokerExit.lean — do not edit
[Unit]
Description=nanodregg keybroker (the provider-key broker) and its decider
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=nd
EnvironmentFile=/etc/nd/keybroker/keybroker.env
RuntimeDirectory=nd-keybroker
# the installed anchors must be the build's pinned roots, byte for byte, at every start (OPS-7)
ExecStartPre=/opt/nd/bin/emit-anchors --check /etc/nd/keybroker/anchors.pem
ExecStart=/opt/nd/bin/keybroker /etc/nd/keybroker/provider.key /etc/nd/keybroker/anchors.pem /etc/nd/keybroker/pins /run/nd-broker /run/nd-keybroker api.anthropic.com:443 /srv/nd/store ${ND_OPERATOR} ${ND_PEER} /opt/nd/bin/hosting-broker
Restart=on-failure
RestartSec=2
RestartPreventExitStatus=70 71 72 73 75 76 78 7 80 81 82 83 84 85 86 87 88 89 90 91 92 93 94 95 96 97 140 141 142 143 144 145 146 147 148 98 99 100 103 104 105 79 149 163 164
# UMask=0027: the setgid resident socket directory must let the hosted group search it (02710); under 0077 it is created 02700 and keybroker refuses sockDir (R4)
UMask=0027
NoNewPrivileges=yes
# AF_INET/AF_INET6 for the upstream call; the decider confines itself (Landlock, seccomp: CLIENT-48) and needs no family
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
