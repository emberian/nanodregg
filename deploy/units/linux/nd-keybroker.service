# GENERATED by emit-units from Ops/Units.lean and Hosting/BrokerExit.lean — do not edit
[Unit]
Description=nanodregg keybroker (the provider-key broker) and its decider
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=nd
EnvironmentFile=/etc/nd/keybroker/keybroker.env
RuntimeDirectory=nd-keybroker
# the installed anchors must be the build's pinned roots, byte for byte, at every start (OPS-7)
ExecStartPre=/opt/nd/bin/emit-anchors --check /etc/nd/keybroker/anchors.pem
ExecStart=/opt/nd/bin/keybroker /etc/nd/keybroker/provider.key /etc/nd/keybroker/anchors.pem /run/nd-broker /run/nd-keybroker api.anthropic.com:443 /srv/nd/store ${ND_OPERATOR} ${ND_PEER} /opt/nd/bin/hosting-broker
Restart=on-failure
RestartSec=2
RestartPreventExitStatus=70 71 72 73 75 76 78 7 80 81 82 83 84 85 86 87 88 89 90 91 92 93 94 95 96 97 98 99 100 103 104 105 79
UMask=0077
NoNewPrivileges=yes
# AF_NETLINK: bwrap --unshare-net brings up the decider sandbox loopback over NETLINK_ROUTE; without it
# the decider dies at every start (measured on burst5, systemd 255, OPS-3 run 1)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
