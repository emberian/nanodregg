# GENERATED by emit-units from Ops/Units.lean and Protocol/Exit.lean (CommandExit) — do not edit
[Unit]
Description=nanodregg follow driver of World %i (nd sync, the trusted side initiates)
Wants=nd-hosted-follow@%i.service
After=nd-hosted-follow@%i.service nd-host-serve.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=nd
Environment=ND_WORKSPACE=/etc/nd/follow/%i ND_FOLLOW_SOCK=/run/nd-follow/%i.sock ND_HOST_SOCK=/run/nd/host.sock
ExecStart=/opt/nd/bin/nd sync
# every end runs again after the interval but the fatal class (a refusal by name)
Restart=always
RestartSec=40
RestartPreventExitStatus=1
UMask=0077
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
