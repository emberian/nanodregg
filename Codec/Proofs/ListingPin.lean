    (cells Sim.env Sim.dc).bytes (Trie.insertAll (trieSpec Sim.env) .empty
      [(.nullifier 9694255593671374634, .spent), (.nullifier 16220329301721906947, .spent),
       (.cell 5537467209141188884, .entry (.live ⟨3168162788, .value, []⟩))]) = cellsPin := by
  decide +kernel

