private theorem T1A_eq : decodePoint pk 0 = some T1A := by decide +kernel
private theorem T1R_eq : decodePoint sig 0 = some T1R := by decide +kernel
private theorem T1S_eq : leNat sig 32 32 = T1S := by decide +kernel
private theorem T1k_eq : leNat (Sha512.hash (sig.extract 0 32 ++ pk ++ ByteArray.empty)).val 0 64 % L = T1k := by
  decide +kernel
private theorem T1c1_eq :
    Point.ladder B T1A.neg (B.add T1A.neg) Point.zero (T1S >>> 192) (T1k >>> 192) 61 = T1c1 := by
  decide +kernel
private theorem T1c2_eq :
    Point.ladder B T1A.neg (B.add T1A.neg) T1c1 (T1S >>> 128) (T1k >>> 128) 64 = T1c2 := by
  decide +kernel
private theorem T1c3_eq :
    Point.ladder B T1A.neg (B.add T1A.neg) T1c2 (T1S >>> 64) (T1k >>> 64) 64 = T1c3 := by
  decide +kernel
private theorem T1c4_eq :
    Point.ladder B T1A.neg (B.add T1A.neg) T1c3 T1S T1k 64 = T1c4 := by
  decide +kernel

/-- RFC 8032 TEST 1: the empty message. -/
theorem test1 : verify pk ByteArray.empty sig = true := by
  rw [verify_eq (by decide) (by decide) (by rw [T1S_eq]; decide) T1A_eq T1R_eq, T1S_eq, T1k_eq,
    mul2_of_chunks (n := 61) rfl T1c1_eq T1c2_eq T1c3_eq T1c4_eq]
  decide +kernel

