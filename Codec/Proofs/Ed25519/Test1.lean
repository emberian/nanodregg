private theorem S1e_eq : expand seed = (S1a, S1pre) := by decide +kernel
private theorem S1pc1_eq :
    Point.ladder B B (B.add B) Point.zero (S1a >>> 192) (0 >>> 192) 64 = S1pc1 := by
  decide +kernel
private theorem S1pc2_eq :
    Point.ladder B B (B.add B) S1pc1 (S1a >>> 128) (0 >>> 128) 64 = S1pc2 := by
  decide +kernel
private theorem S1pc3_eq :
    Point.ladder B B (B.add B) S1pc2 (S1a >>> 64) (0 >>> 64) 64 = S1pc3 := by
  decide +kernel
private theorem S1pc4_eq :
    Point.ladder B B (B.add B) S1pc3 S1a 0 64 = S1pc4 := by
  decide +kernel
private theorem S1rc1_eq :
    Point.ladder B B (B.add B) Point.zero (S1r >>> 192) (0 >>> 192) 64 = S1rc1 := by
  decide +kernel
private theorem S1rc2_eq :
    Point.ladder B B (B.add B) S1rc1 (S1r >>> 128) (0 >>> 128) 64 = S1rc2 := by
  decide +kernel
private theorem S1rc3_eq :
    Point.ladder B B (B.add B) S1rc2 (S1r >>> 64) (0 >>> 64) 64 = S1rc3 := by
  decide +kernel
private theorem S1rc4_eq :
    Point.ladder B B (B.add B) S1rc3 S1r 0 64 = S1rc4 := by
  decide +kernel
private theorem S1pk_eq : encodePoint S1pc4 = pk := by decide +kernel
private theorem S1R_eq : encodePoint S1rc4 = S1Rb := by decide +kernel
private theorem S1r_eq : leNat (Sha512.hash (S1pre ++ ByteArray.empty)).val 0 64 % L = S1r := by decide +kernel
private theorem S1k_eq : leNat (Sha512.hash (S1Rb ++ pk ++ ByteArray.empty)).val 0 64 % L = S1k := by decide +kernel
private theorem S1base : baseMul S1a = S1pc4 := by
  rw [baseMul]; exact mul2_of_chunks (n := 64) rfl S1pc1_eq S1pc2_eq S1pc3_eq S1pc4_eq
private theorem S1rbase : baseMul S1r = S1rc4 := by
  rw [baseMul]; exact mul2_of_chunks (n := 64) rfl S1rc1_eq S1rc2_eq S1rc3_eq S1rc4_eq

theorem publicKey_test1 : publicKey seed = pk := by
  rw [publicKey_eq S1e_eq, S1base, S1pk_eq]

theorem sign_test1 : sign seed ByteArray.empty = sig := by
  rw [sign_eq S1e_eq, S1base, S1pk_eq, S1r_eq, S1rbase, S1R_eq, S1k_eq]
  decide +kernel

