private theorem S2e_eq : expand seed = (S2a, S2pre) := by decide +kernel
private theorem S2pc1_eq :
    Point.ladder B B (B.add B) Point.zero (S2a >>> 192) (0 >>> 192) 64 = S2pc1 := by
  decide +kernel
private theorem S2pc2_eq :
    Point.ladder B B (B.add B) S2pc1 (S2a >>> 128) (0 >>> 128) 64 = S2pc2 := by
  decide +kernel
private theorem S2pc3_eq :
    Point.ladder B B (B.add B) S2pc2 (S2a >>> 64) (0 >>> 64) 64 = S2pc3 := by
  decide +kernel
private theorem S2pc4_eq :
    Point.ladder B B (B.add B) S2pc3 S2a 0 64 = S2pc4 := by
  decide +kernel
private theorem S2rc1_eq :
    Point.ladder B B (B.add B) Point.zero (S2r >>> 192) (0 >>> 192) 64 = S2rc1 := by
  decide +kernel
private theorem S2rc2_eq :
    Point.ladder B B (B.add B) S2rc1 (S2r >>> 128) (0 >>> 128) 64 = S2rc2 := by
  decide +kernel
private theorem S2rc3_eq :
    Point.ladder B B (B.add B) S2rc2 (S2r >>> 64) (0 >>> 64) 64 = S2rc3 := by
  decide +kernel
private theorem S2rc4_eq :
    Point.ladder B B (B.add B) S2rc3 S2r 0 64 = S2rc4 := by
  decide +kernel
private theorem S2pk_eq : encodePoint S2pc4 = pk := by decide +kernel
private theorem S2R_eq : encodePoint S2rc4 = S2Rb := by decide +kernel
private theorem S2r_eq : leNat (Sha512.hash (S2pre ++ ⟨#[0x72]⟩)).val 0 64 % L = S2r := by decide +kernel
private theorem S2k_eq : leNat (Sha512.hash (S2Rb ++ pk ++ ⟨#[0x72]⟩)).val 0 64 % L = S2k := by decide +kernel
private theorem S2base : baseMul S2a = S2pc4 := by
  rw [baseMul]; exact mul2_of_chunks (n := 64) rfl S2pc1_eq S2pc2_eq S2pc3_eq S2pc4_eq
private theorem S2rbase : baseMul S2r = S2rc4 := by
  rw [baseMul]; exact mul2_of_chunks (n := 64) rfl S2rc1_eq S2rc2_eq S2rc3_eq S2rc4_eq

theorem publicKey_test2 : publicKey seed = pk := by
  rw [publicKey_eq S2e_eq, S2base, S2pk_eq]

theorem sign_test2 : sign seed ⟨#[0x72]⟩ = sig := by
  rw [sign_eq S2e_eq, S2base, S2pk_eq, S2r_eq, S2rbase, S2R_eq, S2k_eq]
  decide +kernel

/-- What `sign` produces, `verify` accepts (TEST 2's seed and message). -/
theorem verify_sign_test2 : verify (publicKey seed) ⟨#[0x72]⟩ (sign seed ⟨#[0x72]⟩) = true := by
  rw [publicKey_test2, sign_test2]; exact test2

