private theorem T2A_eq : decodePoint pk 0 = some T2A := by decide +kernel
private theorem T2R_eq : decodePoint sig 0 = some T2R := by decide +kernel
private theorem T2S_eq : leNat sig 32 32 = T2S := by decide +kernel
private theorem T2k_eq : leNat (Sha512.hash (sig.extract 0 32 ++ pk ++ ⟨#[0x72]⟩)).val 0 64 % L = T2k := by
  decide +kernel
private theorem T2c1_eq :
    Point.ladder B T2A.neg (B.add T2A.neg) Point.zero (T2S >>> 192) (T2k >>> 192) 61 = T2c1 := by
  decide +kernel
private theorem T2c2_eq :
    Point.ladder B T2A.neg (B.add T2A.neg) T2c1 (T2S >>> 128) (T2k >>> 128) 64 = T2c2 := by
  decide +kernel
private theorem T2c3_eq :
    Point.ladder B T2A.neg (B.add T2A.neg) T2c2 (T2S >>> 64) (T2k >>> 64) 64 = T2c3 := by
  decide +kernel
private theorem T2c4_eq :
    Point.ladder B T2A.neg (B.add T2A.neg) T2c3 T2S T2k 64 = T2c4 := by
  decide +kernel

/-- RFC 8032 TEST 2: the one-byte message 0x72. -/
theorem test2 : verify pk ⟨#[0x72]⟩ sig = true := by
  rw [verify_eq (by decide) (by decide) (by rw [T2S_eq]; decide) T2A_eq T2R_eq, T2S_eq, T2k_eq,
    mul2_of_chunks (n := 61) rfl T2c1_eq T2c2_eq T2c3_eq T2c4_eq]
  decide +kernel

