import Codec.Ed25519

/-!
# Ed25519 conformance: RFC 8032 §7.1 TEST 1 and TEST 2, kernel-checked

Each is closed by `decide +kernel`: the kernel runs the whole verification (decompression,
SHA-512, the double-scalar multiplication, the cofactored check). No `native_decide` is used and no
compiler is trusted. `test2_tampered` is the plant: the TEST 2 signature over a different message is
refused.
-/

namespace Nanodregg.Codec.Ed25519

private def pk1 : ByteArray := ⟨#[0xd7, 0x5a, 0x98, 0x01, 0x82, 0xb1, 0x0a, 0xb7, 0xd5, 0x4b, 0xfe, 0xd3, 0xc9, 0x64, 0x07, 0x3a,
    0x0e, 0xe1, 0x72, 0xf3, 0xda, 0xa6, 0x23, 0x25, 0xaf, 0x02, 0x1a, 0x68, 0xf7, 0x07, 0x51, 0x1a]⟩

private def sig1 : ByteArray := ⟨#[0xe5, 0x56, 0x43, 0x00, 0xc3, 0x60, 0xac, 0x72, 0x90, 0x86, 0xe2, 0xcc, 0x80, 0x6e, 0x82, 0x8a,
    0x84, 0x87, 0x7f, 0x1e, 0xb8, 0xe5, 0xd9, 0x74, 0xd8, 0x73, 0xe0, 0x65, 0x22, 0x49, 0x01, 0x55,
    0x5f, 0xb8, 0x82, 0x15, 0x90, 0xa3, 0x3b, 0xac, 0xc6, 0x1e, 0x39, 0x70, 0x1c, 0xf9, 0xb4, 0x6b,
    0xd2, 0x5b, 0xf5, 0xf0, 0x59, 0x5b, 0xbe, 0x24, 0x65, 0x51, 0x41, 0x43, 0x8e, 0x7a, 0x10, 0x0b]⟩

private def pk2 : ByteArray := ⟨#[0x3d, 0x40, 0x17, 0xc3, 0xe8, 0x43, 0x89, 0x5a, 0x92, 0xb7, 0x0a, 0xa7, 0x4d, 0x1b, 0x7e, 0xbc,
    0x9c, 0x98, 0x2c, 0xcf, 0x2e, 0xc4, 0x96, 0x8c, 0xc0, 0xcd, 0x55, 0xf1, 0x2a, 0xf4, 0x66, 0x0c]⟩

private def sig2 : ByteArray := ⟨#[0x92, 0xa0, 0x09, 0xa9, 0xf0, 0xd4, 0xca, 0xb8, 0x72, 0x0e, 0x82, 0x0b, 0x5f, 0x64, 0x25, 0x40,
    0xa2, 0xb2, 0x7b, 0x54, 0x16, 0x50, 0x3f, 0x8f, 0xb3, 0x76, 0x22, 0x23, 0xeb, 0xdb, 0x69, 0xda,
    0x08, 0x5a, 0xc1, 0xe4, 0x3e, 0x15, 0x99, 0x6e, 0x45, 0x8f, 0x36, 0x13, 0xd0, 0xf1, 0x1d, 0x8c,
    0x38, 0x7b, 0x2e, 0xae, 0xb4, 0x30, 0x2a, 0xee, 0xb0, 0x0d, 0x29, 0x16, 0x12, 0xbb, 0x0c, 0x00]⟩

/-- RFC 8032 TEST 1: the empty message. -/
theorem test1 : verify pk1 ByteArray.empty sig1 = true := by decide +kernel

/-- RFC 8032 TEST 2: the one-byte message 0x72. -/
theorem test2 : verify pk2 ⟨#[0x72]⟩ sig2 = true := by decide +kernel

/-- TEST 2's signature does not sign 0x73. -/
theorem test2_tampered : verify pk2 ⟨#[0x73]⟩ sig2 = false := by decide +kernel

end Nanodregg.Codec.Ed25519
