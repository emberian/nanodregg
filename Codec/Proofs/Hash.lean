import Codec.Hash

/-!
# Hash conformance: FIPS 202 and NIST SP 800-185 sample vectors, kernel-checked

Each theorem is closed by `decide`, so the kernel itself runs the permutation (Lean's `Nat` is
GMP-backed in the kernel). No `native_decide` is used and no compiler is trusted. The samples are the
published ones: SHA3-256 of "" and "abc" (FIPS 202 examples), cSHAKE256 Sample #4 and KMAC256
Sample #4 (SP 800-185, 512-bit outputs). `Hash.digest` is cSHAKE256 with an empty name. With
the 32-byte output, these pin the padding, the encodings and the permutation.
-/

namespace Nanodregg.Codec.Hash

theorem sha3_256_empty : (sha3_256 ByteArray.empty).data =
    #[0xa7, 0xff, 0xc6, 0xf8, 0xbf, 0x1e, 0xd7, 0x66, 0x51, 0xc1, 0x47, 0x56, 0xa0, 0x61, 0xd6, 0x62,
      0xf5, 0x80, 0xff, 0x4d, 0xe4, 0x3b, 0x49, 0xfa, 0x82, 0xd8, 0x0a, 0x4b, 0x80, 0xf8, 0x43, 0x4a] := by decide +kernel

theorem sha3_256_abc : (sha3_256 "abc".toUTF8).data =
    #[0x3a, 0x98, 0x5d, 0xa7, 0x4f, 0xe2, 0x25, 0xb2, 0x04, 0x5c, 0x17, 0x2d, 0x6b, 0xd3, 0x90, 0xbd,
      0x85, 0x5f, 0x08, 0x6e, 0x3e, 0x9d, 0x52, 0x5b, 0x46, 0xbf, 0xe2, 0x45, 0x11, 0x43, 0x15, 0x32] := by decide +kernel

/-- SP 800-185 cSHAKE256 Sample #4: X = 00 01 02 03, N = "", S = "Email Signature", L = 512. -/
theorem cshake256_sample4 :
    (cshake256 ByteArray.empty "Email Signature".toUTF8 ⟨#[0, 1, 2, 3]⟩ 64 (by decide)).val.data =
    #[0xd0, 0x08, 0x82, 0x8e, 0x2b, 0x80, 0xac, 0x9d, 0x22, 0x18, 0xff, 0xee, 0x1d, 0x07, 0x0c, 0x48,
      0xb8, 0xe4, 0xc8, 0x7b, 0xff, 0x32, 0xc9, 0x69, 0x9d, 0x5b, 0x68, 0x96, 0xee, 0xe0, 0xed, 0xd1,
      0x64, 0x02, 0x0e, 0x2b, 0xe0, 0x56, 0x08, 0x58, 0xd9, 0xc0, 0x0c, 0x03, 0x7e, 0x34, 0xa9, 0x69,
      0x37, 0xc5, 0x61, 0xa7, 0x4c, 0x41, 0x2b, 0xb4, 0xc7, 0x46, 0x46, 0x95, 0x27, 0x28, 0x1c, 0x8c] := by decide +kernel

/-- SP 800-185 KMAC256 Sample #4: K = 40..5F, X = 00 01 02 03, L = 512, S = "My Tagged Application". -/
theorem kmac256_sample4 :
    (kmac256 ⟨#[0x40, 0x41, 0x42, 0x43, 0x44, 0x45, 0x46, 0x47, 0x48, 0x49, 0x4a, 0x4b, 0x4c, 0x4d, 0x4e, 0x4f,
      0x50, 0x51, 0x52, 0x53, 0x54, 0x55, 0x56, 0x57, 0x58, 0x59, 0x5a, 0x5b, 0x5c, 0x5d, 0x5e, 0x5f]⟩
      ⟨#[0, 1, 2, 3]⟩ 64 (by decide) "My Tagged Application".toUTF8).val.data =
    #[0x20, 0xc5, 0x70, 0xc3, 0x13, 0x46, 0xf7, 0x03, 0xc9, 0xac, 0x36, 0xc6, 0x1c, 0x03, 0xcb, 0x64,
      0xc3, 0x97, 0x0d, 0x0c, 0xfc, 0x78, 0x7e, 0x9b, 0x79, 0x59, 0x9d, 0x27, 0x3a, 0x68, 0xd2, 0xf7,
      0xf6, 0x9d, 0x4c, 0xc3, 0xde, 0x9d, 0x10, 0x4a, 0x35, 0x16, 0x89, 0xf2, 0x7c, 0xf6, 0xf5, 0x95,
      0x1f, 0x01, 0x03, 0xf3, 0x3f, 0x4f, 0x24, 0x87, 0x10, 0x24, 0xd9, 0xc2, 0x77, 0x73, 0xa8, 0xdd] := by decide +kernel

end Nanodregg.Codec.Hash
