(package
  (state (rec (cap nat) (keySlot nat) (maxTokens nat) (microPerKTok nat) (model bytes) (resident bytes)
              (revoked bool) (windowMs nat)))
  (method revoke (done (with state (revoked true))))
  (method set (arg (rec (cap nat) (keySlot nat) (maxTokens nat) (microPerKTok nat) (windowMs nat)))
    (done (with state (cap arg.cap) (keySlot arg.keySlot) (maxTokens arg.maxTokens)
                      (microPerKTok arg.microPerKTok) (windowMs arg.windowMs)))))
