(package
  (doc "The depositor deposits amount of asset into an account the escrow owns; release pays it to the beneficiary (the depositor or arbiter asks), refund back to the depositor (the beneficiary or arbiter asks); exactly one payout.")
  (type Phase (enum held open refunded released))
  (state (rec (amount nat) (arbiter digest) (asset digest) (beneficiary digest) (depositor digest)
              (nonce bytes) (phase Phase)))
  (method deposit (arg (rec (grant digest))) (calls (transfer)) (effect (moves 1000))
    (done (with state (phase (Phase held)))
      (transfer (amount state.amount) (dst (AcctRef of (record (asset state.asset) (owner req.self))))
                (once (some bytes state.nonce)) (src (AcctRef of (record (asset state.asset) (owner state.depositor))))
                (via (some digest arg.grant)))))
  (method refund (calls (transfer)) (effect (moves 1000))
    (done (with state (phase (Phase refunded)))
      (transfer (amount state.amount) (dst (AcctRef of (record (asset state.asset) (owner state.depositor))))
                (once (some bytes "payout")) (src (AcctRef of (record (asset state.asset) (owner req.self))))
                (via (none digest)))))
  (method release (calls (transfer)) (effect (moves 1000))
    (done (with state (phase (Phase released)))
      (transfer (amount state.amount) (dst (AcctRef of (record (asset state.asset) (owner state.beneficiary))))
                (once (some bytes "payout")) (src (AcctRef of (record (asset state.asset) (owner req.self))))
                (via (none digest)))))
  (law escrow
    (on (adopt birth) (all ((is Phase old.phase open) "notOpen") ((is Phase new.phase open) "notOpen")))
    (on (relaw write) (refuse "frozen"))
    (on invoke m
      (check ((not (any (is Phase old.phase refunded) (is Phase old.phase released))) "settled")
        (if (== m (index deposit))
          (all ((is Phase old.phase open) "notOpen") ((any (deq req.agent old.depositor)) "notParty")
               ((is Phase new.phase held) "badPhase"))
        (if (== m (index refund))
          (all ((is Phase old.phase held) "notHeld") ((any (deq req.agent old.beneficiary) (deq req.agent old.arbiter)) "notParty")
               ((is Phase new.phase refunded) "badPhase"))
        (if (== m (index release))
          (all ((is Phase old.phase held) "notHeld") ((any (deq req.agent old.depositor) (deq req.agent old.arbiter)) "notParty")
               ((is Phase new.phase released) "badPhase"))
          (refuse "noMethod"))))))))
