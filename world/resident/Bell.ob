; Bell is an activity instance. Its public wrappers preserve the established
; argument bounds and refusal names; continuation guards apply to every layer.
; The declared key is time first, then signer, so the resident reads in ring order.
(package
  (doc "A ring is answered once, by the resident, with its text sent back; a ringer can backdate by at most the kernel's window (1024 heights); ties at one height go by ringer digest; an unanswered ring may be retired by anyone from its notBefore + 2048.")
  (state (rec (open bool) (resident digest)))
  (activity pending rings (limits 64 1024) (patience 2048)
    (expose) (guards queued rung) (refusals "notResident" "unrung" "text")
    (resumer (deq req.agent state.resident))
    (plan ask (arg (rec (text bytes))) (resp bytes)
      (start state) (resume state)))
  (method answer (arg (rec (notBefore nat) (ringText (bytes 1 2000)) (ringer digest) (text (bytes 1 2000))))
    (edits 2)
    (check ((deq req.agent state.resident) "notResident")
      (done state
        (upsert rings (record (agent arg.ringer) (notBefore arg.notBefore))
          (record (answered (some (sum (ask bytes)) (inj (sum (ask bytes)) ask arg.text)))
            (captured (inj (sum (ask (rec (text bytes)))) ask (record (text arg.ringText))))))
        (retract pending (record (agent arg.ringer) (notBefore arg.notBefore))))))
  (method close (done (with state (open false))))
  (method open (done (with state (open true))))
  (method retire (reads (rings (points 1))) (arg (rec (notBefore nat) (ringer digest))) (edits 2)
    (case rows.rings.p0 (none _ (refuse "unrung"))
      (some p (case p.val (none _ (refuse "unrung"))
        (some q (check ((and (== p.key.notBefore arg.notBefore) (deq p.key.agent arg.ringer)) "unrung")
          (case q.answered
            (none _ (done state (retract rings p.key) (retract pending p.key)))
            (some _ (done state (retract rings p.key))))))))))
  (method ring (arg (rec (text (bytes 1 2000)))) (edits 2)
    (check (state.open "closed")
      ((activity-code start_ask) (record) state arg req)))
  (law bell (on invoke m (all ((deq new.resident old.resident) "resident"))) (else ok)))
