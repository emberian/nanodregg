; The Bell: a queue of rings a resident answers (LANG-58). A ring is keyed (notBefore, ringer): its
; signed notBefore, so a ringer can jump the queue by at most the kernel's windowMax (1024) heights;
; ties at one height go by ringer digest; one ringer twice from one view is keyTaken.
; `pending` is exactly the unanswered rings, in ring order: the resident reads `read BELL pending 64`.
(package
  (state (rec (open bool) (resident digest)))
  (rel answers (key (notBefore nat) (ringer digest)) (val (rec (text bytes))) (limit 1024) (retract) (guard said))
  (rel pending (key (notBefore nat) (ringer digest)) (val (rec (text bytes))) (limit 64) (retract) (guard queued))
  (rel rings (key (notBefore nat) (ringer digest)) (val (rec (text bytes))) (limit 1024) (retract) (guard rung))
  (method answer (arg (rec (notBefore nat) (ringer digest) (text (bytes 1 2000)))) (edits 2)
    (check ((deq req.agent state.resident) "notResident")
      (done state (insert answers (record (notBefore arg.notBefore) (ringer arg.ringer)) (record (text arg.text)))
        (retract pending (record (notBefore arg.notBefore) (ringer arg.ringer))))))
  (method close (done (with state (open false))))
  (method open (done (with state (open true))))
  (method retire (arg (rec (notBefore nat) (ringer digest))) (edits 2)
    (done state (retract answers (record (notBefore arg.notBefore) (ringer arg.ringer)))
      (retract rings (record (notBefore arg.notBefore) (ringer arg.ringer)))))
  (method ring (arg (rec (text (bytes 1 2000)))) (edits 2)
    (check (state.open "closed")
      (done state (insert pending (record (notBefore req.notBefore) (ringer req.agent)) (record (text arg.text)))
        (insert rings (record (notBefore req.notBefore) (ringer req.agent)) (record (text arg.text))))))
  (guard queued (case edit (insert x (if (deq x.key.ringer req.agent) ok (refuse "notYours")))
    (retract x (if (deq req.agent state.resident) ok (refuse "notResident"))) (upsert x (refuse "final"))))
  (guard rung (case edit (insert x (if (deq x.key.ringer req.agent) ok (refuse "notYours")))
    (retract x ok) (upsert x (refuse "final"))))
  (guard said (case edit (insert x (if (deq req.agent state.resident) ok (refuse "notResident")))
    (retract x ok) (upsert x (refuse "final"))))
  (law bell (on invoke m (all ((deq new.resident old.resident) "resident"))) (else ok)))
