#!/usr/bin/env bash
# scripts/size-sync PATH... — rewrite SIZE.md's `now` column for the commit you are about to
# make: HEAD plus exactly these working-tree paths (the same set `git commit --only PATH...`
# records). Then commit with SIZE.md among the paths:  git commit --only PATH... SIZE.md
set -uo pipefail
. "$(dirname "$0")/gate-lib.sh"
[ $# -gt 0 ] || { echo "usage: scripts/size-sync PATH..." >&2; exit 2; }
tmp=$(mktemp -d)
idx=$tmp/index
GIT_INDEX_FILE=$idx git -C "$repo" read-tree HEAD
(cd "$repo" && GIT_INDEX_FILE=$idx git add -A -- "$@")
tree=$(GIT_INDEX_FILE=$idx git -C "$repo" write-tree)
G=$common/nanodregg-size
lock nanodregg-size || exit 2
materialize "$tree" "$G/tree"
cp "$repo/SIZE.md" "$G/tree/SIZE.md" 2>/dev/null || true
python3 "$G/tree/gates/size.py" "$G/tree" --write >/dev/null
cp "$G/tree/SIZE.md" "$repo/SIZE.md"
rm -rf "$tmp"
git -C "$repo" diff --stat -- SIZE.md
echo "size-sync: SIZE.md now = HEAD + $*"
