#!/usr/bin/env bash
# scripts/pre-push — judge one candidate commit before it reaches main.
#
#   scripts/pre-push --index [--base COMMIT] [--message FILE]
#                                               the tree in the index, judged against COMMIT
#                                               (default main). scripts/commit passes the main
#                                               it built the candidate on: judged against a main
#                                               that moved meanwhile, the candidate would appear
#                                               to revert every intervening commit
#   scripts/pre-push --rev REV                  an existing commit, judged against its parent
#   --no-build                                  skip build + census; needs `NO-BUILD: <reason>`
#   --record FILE [--reuse PREV]                (scripts/commit, GATES-19) write the ok units of this
#                                               judge with their input keys to FILE; carry a unit
#                                               of PREV (the lander's previous judge) only when its
#                                               key is byte-identical; re-compute every key on the
#                                               candidate before the verdict (`stale verdict: U`)
#   --verify FILE [--reuse PREV]                only re-compute the keys of record FILE on the
#                                               candidate (materialized and built in a slot)
#   --fast                                      (scripts/commit, GATES-22) the per-landing judge of a change that
#                                               is not a flag day and leaves the judge's code alone (gates/fast.py
#                                               mode): steps 0-1, then `lake build` of only the targets the change
#                                               reaches and `cargo check` + `cargo fmt --check` of only the packages
#                                               it reaches (gates/fast.py targets/crates), the declaration diff, the
#                                               axiom + statement census over the reach (GATES-20v (c)). The
#                                               refine census, the plants, the rows, the
#                                               benches, the waste measurements, the generated files and clippy run
#                                               at the next CONVERGENCE (scripts/converge), not here
#   --lean-lacks FILE                           (scripts/commit, GATES-20t) the `.lean` lacks gates/rebase.py `stale`
#                                               found by text and did not refuse: the declaration diff decides them
#
# Steps, all against a private copy of exactly that tree (never the shared working tree):
#   0. ownership: every changed path belongs to the layer named by the subject prefix, per the
#      PARENT's gates/OWNERS (a commit cannot grant itself a path); a `CROSS-LAYER: <reason>`
#      message line is the recorded override;
#   1. source gates (gates/check.py) as the PARENT defines them and as the candidate defines
#      them; both must pass, so a commit cannot weaken a gate and pass by its own weakened gate
#      (a message line `GATE-CHANGE: <why>` lets a deliberate gate change pass the parent's
#      gates; it is printed in the verdict);
#   2. `lake build` of every target (lake's traces decide what rebuilds), under the clone's build
#      wrapper (git config nanodregg.buildwrap; hbox: swarm-build), in one of N judge slots
#      (gate-lib.sh gate_slot);
#   3. the axiom census over every module, the verdict runs (gates/runs.py) of every exe whose import
#      closure holds a changed module, the measured waste ratios against their ceilings,
#      and every gates/generated.tsv file equal to what its
#      Lean generator emits (`lake exe emit-rust --check client/src/generated.rs`);
#   2b. the declaration diff (gates/decls.py, GATES-20t, R-0023), in both modes after the build: every
#      declaration of the parent the candidate lacks, and every theorem whose statement it changes, is named by a
#      `RESTATES:`/`RENAMES:`/`DELETES:` message line; a `.lean` copy that lacks a window commit's change is
#      refused by the declarations holding those lines (--lean-lacks), never by their text;
#   4. the Rust workspace whole (root Cargo.toml) when a member or the root manifest/lock changed:
#      `cargo check --locked --workspace --all-targets`, clippy -D warnings, `cargo fmt --all --check`.
# Prints one verdict line. Exit 0 = may land; 1 = RED; 76 = not judged (KILLED(load), a run past its
# wall-clock deadline twice: UNREAD(timeout), GATES-16; or every judge slot busy for 30 min: a wait is
# not a verdict, GATES-22).
set -uo pipefail
. "$(dirname "$0")/gate-lib.sh"

mode=index rev="" msg="" build=1 basec=refs/heads/main record="" reuse="" verify="" fast=0 leanlacks=""
while [ $# -gt 0 ]; do
  case $1 in
    --index) mode=index ;;
    --rev) mode=rev; rev=$2; shift ;;
    --base) basec=$2; shift ;;
    --message) msg=$2; shift ;;
    --no-build) build=0 ;;
    --record) record=$2; shift ;;
    --reuse) reuse=$2; shift ;;
    --verify) verify=$2; shift ;;
    --fast) fast=1 ;;
    --lean-lacks) leanlacks=$2; shift ;;
    *) echo "usage: scripts/pre-push [--index [--base COMMIT] | --rev REV] [--message FILE] [--no-build]" >&2; exit 2 ;;
  esac
  shift
done

if [ "$mode" = index ]; then
  cand=$(git -C "$repo" write-tree) || exit 2
  # The parent is the main the candidate was built on, never this worktree's HEAD.
  base=$(git -C "$repo" rev-parse -q --verify "$basec^{tree}" || echo "$empty_tree")
else
  cand=$(git -C "$repo" rev-parse "$rev^{tree}") || exit 2
  base=$(git -C "$repo" rev-parse -q --verify "$rev^^{tree}" || echo "$empty_tree")
  msg=$(mktemp); git -C "$repo" log -1 --format=%B "$rev" > "$msg"
fi
[ -n "$msg" ] || { msg=$(mktemp); : > "$msg"; }

# GATES-22 (ROOT, from the lanes: a lane waited 30 min for a slot to learn it indented a CROSS-LAYER line): THE SOURCE
# GATES RUN FIRST, before any slot is asked for, on a private copy of the candidate and its parent: ownership,
# SIZE lines, CROSS-LAYER, the waste and ceiling ratchets, closure, … (gates/check.py, the candidate's and the
# parent's). A red there is refused in seconds, naming the lines to add; the slot judge does not run them again.
prelint="" G=""
if [ -z "$verify" ]; then
  F=$(mktemp -d); trap 'rm -rf "$F"' EXIT
  materialize "$cand" "$F/tree" && materialize "$base" "$F/base" || exit 2
  git -C "$repo" diff --name-only "$base" "$cand" > "$F/changed"
  pl=(--owners-from "$F/base" --base-tree "$F/base" --base-waste "$F/base/gates/waste.tsv" --message "$msg" --changed "$F/changed")
  pf="" prenote=""
  python3 "$F/tree/gates/check.py" "$F/tree" "${pl[@]}" > "$F/gates.out" 2>&1 && echo "  gates: ok" || { echo "  gates: RED"; pf="$pf gates"; }
  if [ -f "$F/base/gates/check.py" ]; then
    if python3 "$F/base/gates/check.py" "$F/tree" "${pl[@]}" > "$F/parent-gates.out" 2>&1; then echo "  parent-gates: ok"
    elif grep -qE '^GATE-CHANGE:[[:space:]]*[^[:space:]]' "$msg"; then
      prenote=" (parent's gates RED; passed on GATE-CHANGE)"; echo "  parent-gates: RED, accepted by GATE-CHANGE"
    else echo "  parent-gates: RED"; pf="$pf parent-gates"; fi
  fi
  if [ -n "$pf" ]; then
    echo "PRE-PUSH RED tree ${cand:0:12}:$pf — the source gates, before any slot (nothing was built)"
    cat "$F/gates.out" "$F/parent-gates.out" 2>/dev/null | grep -E '^  [a-z-]+: ' | grep -v ': PRE-EXISTING ' | awk '!seen[$0]++' | head -40
    exit 1
  fi
  prelint=1
fi
# GATES-22: a fast judge decides what it builds BEFORE it asks for a slot (a slot is a warm .lake and cargo target;
# the source gates need none). Nothing to build and no package to check: judged in a private directory, no slot.
if [ $fast = 1 ]; then
  JF=$(cd "$(dirname "$0")/.." && pwd)/gates/fast.py
  targets=$(python3 "$JF" targets "$F/tree" --changed "$F/changed") || { echo "PRE-PUSH FAST RED: gates/fast.py targets failed"; exit 1; }
  crates=$(python3 "$JF" crates "$F/tree" --changed "$F/changed") || { echo "PRE-PUSH FAST RED: gates/fast.py crates failed"; exit 1; }
  [ "$build" = 0 ] && targets=""
  if [ -z "$targets" ] && [ -z "$crates" ]; then G=$F; echo "  slot: none (nothing to build, no package to check)"; fi
fi
if [ -z "$G" ]; then
  gate_slot; rc=$?
  # a slot that never freed is not a verdict about the commit (GATES-22; it read REFUSED until then); gate_slot
  # has named the holders
  [ $rc -eq 3 ] && { echo "PRE-PUSH NOT JUDGED: no judge slot freed (holders above); re-run"; exit 76; }
  [ $rc -eq 0 ] || exit 2
fi
export CARGO_TARGET_DIR=$G/cargo-target   # one Rust target per slot: workspace, cargo runs rows, cargo generators
materialize "$cand" "$G/tree" || exit 2
materialize "$base" "$G/base" || exit 2
# One log per judged tree, kept (the newest 20 per slot): a slot's next judge must not overwrite
# the log a refused lane is about to read.
log=$G/${cand:0:12}.log
: > "$log"
ls -t "$G"/*.log 2>/dev/null | tail -n +21 | while read -r old; do rm -f "$old"; done
fail=""
note=${prenote:-}
killed=""
# GATES-19: input keys, computed and re-checked by the JUDGE's gates/rebase.py (this script's tree:
# main's copy under scripts/commit), never the candidate's, so a candidate cannot widen its own reuse.
J=$(cd "$(dirname "$0")/.." && pwd)/gates
keyed() { [ -n "$record" ] && [ -f "$J/rebase.py" ]; }
if [ -n "$verify" ]; then record=$verify; fi
: > "$G/keys"
if keyed; then
  [ -n "$verify" ] || : > "$record"
  git -C "$repo" ls-tree -r -z --full-tree "$cand" > "$G/listing" || exit 2
fi
# compute_keys: every unit's key, after the build (the run keys cover the built binaries).
compute_keys() {
  : > "$G/keys"
  keyed || return 0
  python3 "$J/rebase.py" keys --listing "$G/listing" --tree "$G/tree" --table "$G/tree/gates/runs.tsv" > "$G/keys" 2>> "$log" ||
    { echo "  keys: could not be computed (see the log); nothing is carried"; : > "$G/keys"; }
}
# verify_keys [--skip-runs]: the final re-check of the record on the candidate as it is now.
verify_keys() {
  keyed || return 0
  if python3 "$J/rebase.py" verify --listing "$G/listing" --tree "$G/tree" --table "$G/tree/gates/runs.tsv" \
       --record "$record" ${reuse:+--reuse "$reuse"} "$@" > "$G/verify.out" 2>&1; then
    sed 's/^/  /' "$G/verify.out" >> "$log"
  else
    sed 's/^/  /' "$G/verify.out" | tee -a "$log"; echo "  stale-verdict: RED"; fail="$fail stale-verdict"
  fi
}
# keyed_step UNIT CMD...: `step`, unless UNIT's key is byte-identical to the one under which the
# lander's previous judge recorded it ok; an ok result is recorded.
keyed_step() {
  local unit=$1 k p; shift
  k=$(awk -F'\t' -v u="$unit" '$1 == u {print $2}' "$G/keys" 2>/dev/null)
  p=$( [ -n "$reuse" ] && [ -f "$reuse" ] && awk -F'\t' -v u="$unit" '$1 == u {print $2}' "$reuse")
  if [ -n "$k" ] && [ "$k" = "$p" ]; then
    echo "  $unit: ok (reused: key ${k:0:16}, byte-identical to the previous judge's)"
    printf '%s\t%s\treused\t{}\n' "$unit" "$k" >> "$record"; return
  fi
  [ -n "$p" ] && echo "  reuse $unit: re-run (key changed)"
  local f0=$fail k0=$killed
  step "$unit" "$@"
  if [ -n "$k" ] && keyed && [ "$fail" = "$f0" ] && [ "$killed" = "$k0" ]; then printf '%s\t%s\trun\t{}\n' "$unit" "$k" >> "$record"; fi
}
if [ -n "$verify" ]; then
  wrapped env -C "$G/tree" LEAN_NUM_THREADS="${LEAN_NUM_THREADS:-4}" lake build $(lean_exes "$G/tree") >> "$log" 2>&1 ||
    { echo "PRE-PUSH VERIFY: the build failed — log: $log"; exit 1; }
  keyed || { echo "PRE-PUSH VERIFY: no gates/rebase.py beside this pre-push"; exit 2; }
  verify_keys
  if [ -n "$fail" ]; then echo "PRE-PUSH VERIFY RED tree ${cand:0:12}"; exit 1; fi
  echo "PRE-PUSH VERIFY ok tree ${cand:0:12}: $(cat "$G/verify.out")"; exit 0
fi

# step NAME CMD...: run, log, remember failure. A step whose Lean or cargo process was killed by a
# signal (earlyoom's SIGTERM: `Lean exited with code 143`; the cgroup's SIGKILL: 137) is not a
# verdict about the commit: it is KILLED(load), named, never RED, and the commit is not judged.
step() {
  local name=$1; shift
  "$@" > "$G/step.out" 2>&1; local rc=$?
  cat "$G/step.out" >> "$log"
  if [ $rc -eq 0 ]; then echo "  $name: ok"
  elif { [ $rc -eq 137 ] || [ $rc -eq 143 ] || grep -qE 'exited with code (137|143)|signal: (9|15)|\(signal (9|15)\)' "$G/step.out"; } &&
       ! grep -qE '^error: [^ ]+\.lean:[0-9]+:[0-9]+:' "$G/step.out"; then  # a real error beside a kill is RED
    echo "  $name: KILLED(load) — re-run"; killed="$killed $name"
  else echo "  $name: RED"; fail="$fail $name"; fi
}

git -C "$repo" diff --name-only "$base" "$cand" > "$G/changed"

# GATES-20t (R-0023): THE DECLARATION DIFF, by the JUDGE's gates/decls.py over the census environment. DC is the
# per-tree digest cache: the parent's digest is read from it (each landing caches its candidate's, which is main's
# tree once it lands); on a miss the parent is built in this slot and exported whole BEFORE the candidate is built.
DC=$common/nanodregg-decls
decls_lean() { grep -qE '\.lean$' "$G/changed"; }
decls_parent() {
  [ "$mode" = index ] && [ "$build" = 1 ] && decls_lean || return 0
  python3 "$J/decls.py" have --cache "$DC" --tree "$base" && return 0
  echo "  decls: the parent's declarations are not cached (${base:0:12}): the parent is built in this slot and exported whole"
  # shellcheck disable=SC2046
  if materialize "$base" "$G/tree" &&
     wrapped env -C "$G/tree" LEAN_NUM_THREADS="${LEAN_NUM_THREADS:-4}" lake build $(python3 "$J/decls.py" libs --root "$G/tree") >> "$log" 2>&1 &&
     wrapped python3 "$J/decls.py" bootstrap --root "$G/tree" --cache "$DC" --tree "$base" >> "$log" 2>&1; then :
  else echo "  decls: the parent could not be built and exported (the judge below reads NO VERDICT; see the log)"; fi
  materialize "$cand" "$G/tree" || exit 2
}
decls_judge() {
  [ "$mode" = index ] || return 0
  if [ "$build" = 0 ] && decls_lean; then
    echo "  decls: RED — a changed module cannot be judged without a build (--no-build)"; fail="$fail decls"; return
  fi
  case " $fail $killed " in *" build "*) echo "  decls: SKIPPED (the build did not pass)"; return ;; esac
  local da=(--root "$G/tree" --base-root "$G/base" --cache "$DC" --base "$base" --cand "$cand" --changed "$G/changed" --message "$msg")
  [ -n "$leanlacks" ] && da+=(--lean-lacks "$leanlacks")
  step decls wrapped python3 "$J/decls.py" judge "${da[@]}"
  grep -E '^decls: ok' "$G/step.out" | sed 's/^/  /' || true
}
decls_parent

# runs_reds TREE OUT: run TREE's selected verdict exes with the JUDGE's runner ($J: this script's tree,
# main's copy under scripts/commit) over the CANDIDATE's table ($G/judge, a copy of its runs.tsv and
# waste.tsv: data only), and print the red keys (`run EXE ARGS`, `waste OP METRIC`) judged against the
# candidate's waste ceilings, so the parent is judged by exactly the candidate's runs and bars (a run
# whose binary the parent lacks is ABSENT there, so its red is new). Returns runs.py's exit.
# A runner with no verdict is red, never ok and never PRE-EXISTING (GATES-15): the reasons go to
# OUT.crash. Before GATES-15 a crashed runs.py (a traceback, exit 1, no `run …: RED` line) read
# `runs: ok`, because the keys were the only thing read.
runs_reds() {
  local t=$1 out=$2 rc wrc; shift 2
  : > "$out.waste"; : > "$out.crash"
  # GATES-20g: the selected rows run concurrently, this slot's row plus free judge slots borrowed per row (traced only)
  wrapped python3 "$J/runs.py" "$t" --table "$G/judge/gates/runs.tsv" --changed "$G/changed" --waste-out "$out.waste" \
    --slots-dir "$common" --slots "$(slot_count)" "$@" > "$out" 2>> "$log"; rc=$?
  python3 "$J/waste.py" "$G/judge" --measured "$out.waste" --partial > "$out.wred" 2>&1; wrc=$?
  { sed -n 's/^  run \(.*\): RED.*/run \1/p' "$out"
    sed -n 's/^    red \(.*\)$/red \1/p' "$out"
    sed -n 's/^waste \([^ ]*\) \([^:]*\): measured.*/waste \1 \2/p' "$out.wred"; } > "$out.keys"
  grep -q '^runs: ' "$out" || echo "runs.py printed no verdict line (exit $rc): see the log" >> "$out.crash"
  case $rc in 0|3|76) ;; 1) grep -q '^run ' "$out.keys" || echo "runs.py exit 1 with no named red" >> "$out.crash" ;;
    *) echo "runs.py exit $rc" >> "$out.crash" ;; esac
  grep -q '^waste-measured: ' "$out.wred" || echo "waste.py printed no verdict line (exit $wrc): $(tail -1 "$out.wred")" >> "$out.crash"
  case $wrc in 0) ;; 1) grep -q '^waste ' "$out.keys" || echo "waste.py exit 1 with no named red" >> "$out.crash" ;;
    *) echo "waste.py exit $wrc" >> "$out.crash" ;; esac
  return $rc
}

# judge_runs: the candidate's runs and waste; a red the PARENT has too is PRE-EXISTING and does not
# block (GATES-8: a commit is refused for the reds it introduces). The parent is judged only when the
# candidate has a red: the slot's tree is re-materialized at the parent, the selected exes rebuilt
# (lake's traces: the delta only) and run, and the slot is re-materialized at the candidate.
judge_runs() {
  rm -rf "$G/judge"; mkdir -p "$G/judge/gates"
  # GATES-20 (ROOT 10-20): the candidate supplies DATA (runs.tsv, waste.tsv), never the runner's code:
  # a candidate's gates/*.py is never executed by its own judge, so a runs.py change lands under main's
  # runner (a new row KIND and its first rows are two commits). Before, its own runs.py judged it.
  if ! cp "$G/tree/gates/runs.tsv" "$G/judge/gates/"; then
    echo "  runs: RED (the table could not be copied)"; fail="$fail runs"; return
  fi
  cp "$G/tree/gates/waste.tsv" "$G/judge/gates/" 2>/dev/null || : > "$G/judge/gates/waste.tsv"
  local ka=()
  keyed && [ -s "$G/keys" ] && ka=(--keys "$G/keys" --record "$record" ${reuse:+--reuse "$reuse"})
  # GATES-20 (ROOT F1): every judge traces every run; the read-sets narrow selection and key reuse.
  # The parent run below is untraced and statically selected (a red the parent did not run is NEW).
  ka+=(--traces "$common/nanodregg-traces" --git-dir "$repo" --base "$base" --base-table "$G/base/gates/runs.tsv" --tree-oid "$cand")
  runs_reds "$G/tree" "$G/runs.cand" "${ka[@]}"; local rc=$?
  cat "$G/runs.cand" "$G/runs.cand.wred" >> "$log"
  # The final re-check of every carried and recorded key, while the slot still holds the
  # candidate's binaries (a parent judge below rebuilds them).
  verify_keys
  grep -E '^  run |^    red |^  reuse |^  selection: |^  select |^  trace: |^  outside |^  alone |^  concurrency: |^  runs wall: ' "$G/runs.cand" | grep -vE ': ok(\(known-red control read red\))?$' || true
  grep '^waste .*measured' "$G/runs.cand.wred" || true
  # 76: a run was killed by a signal, or ran past its wall-clock deadline twice (GATES-16): no
  # verdict about the commit either way, never RED and never green.
  if [ $rc -eq 76 ] && [ ! -s "$G/runs.cand.crash" ]; then
    echo "  runs: NOT JUDGED ($(sed -n 's/^runs: \([^ ]*\).*/\1/p' "$G/runs.cand")) — re-run"; killed="$killed runs"; return
  fi
  # No verdict is red, and so is a run whose binary is missing after a green build: neither has a
  # parent to share it with (the candidate's own runner and build).
  grep -E '^  run .*: ABSENT' "$G/runs.cand" | sed 's/^  run /run /' >> "$G/runs.cand.crash"
  if [ -s "$G/runs.cand.crash" ]; then
    sed 's/^/  runs: NO VERDICT /' "$G/runs.cand.crash"; echo "  runs: RED"; fail="$fail runs"; return
  fi
  # GATES-20j (ROOT 10-21): a skipped cargo test is pending here, and the verdict line names the first skip
  local sk; sk=$(grep -m1 -o 'INCOMPLETE(skipped: .*' "$G/runs.cand" || true)
  [ -n "$sk" ] && note="$note (pending: ${sk:0:240})"
  if [ ! -s "$G/runs.cand.keys" ]; then
    echo "  runs: ok$( [ $rc -eq 3 ] && echo ', with pending rows') ($(tail -1 "$G/runs.cand" | sed 's/^runs: [A-Za-z]* //'))"; return
  fi
  local new
  if materialize "$base" "$G/tree" &&
     wrapped env -C "$G/tree" LEAN_NUM_THREADS="${LEAN_NUM_THREADS:-4}" lake build $(lean_exes "$G/tree") >> "$log" 2>&1; then
    runs_reds "$G/tree" "$G/runs.base"; cat "$G/runs.base" >> "$log"
    new=$(grep -vxF -f "$G/runs.base.keys" "$G/runs.cand.keys" || true)
    grep -xF -f "$G/runs.base.keys" "$G/runs.cand.keys" | sed 's/^/  runs: PRE-EXISTING /' || true
    materialize "$cand" "$G/tree" || exit 2   # the steps after this one judge the candidate
  else
    materialize "$cand" "$G/tree" || exit 2
    new=$(cat "$G/runs.cand.keys"); echo "  runs: (the parent could not be judged; every red counts)"
  fi
  if [ -n "$new" ]; then printf '%s\n' "$new" | sed 's/^/  runs: NEW RED /'; echo "  runs: RED"; fail="$fail runs"
  else echo "  runs: ok (every red is PRE-EXISTING)"; fi
}
args=(--owners-from "$G/base" --base-tree "$G/base" --base-waste "$G/base/gates/waste.tsv" --message "$msg" --changed "$G/changed")
if [ -n "$prelint" ]; then
  cat "$F/gates.out" "$F/parent-gates.out" >> "$log" 2>/dev/null   # judged above, before the slot, on the same trees
else
step gates python3 "$G/tree/gates/check.py" "$G/tree" "${args[@]}"
fi
if [ -z "$prelint" ] && [ -f "$G/base/gates/check.py" ]; then
  if ! python3 "$G/base/gates/check.py" "$G/tree" "${args[@]}" >> "$log" 2>&1; then
    if grep -qE '^GATE-CHANGE:[[:space:]]*[^[:space:]]' "$msg"; then
      note=" (parent's gates RED; passed on GATE-CHANGE)"; echo "  parent-gates: RED, accepted by GATE-CHANGE"
    else
      echo "  parent-gates: RED"; fail="$fail parent-gates"
    fi
  else
    echo "  parent-gates: ok"
  fi
fi

# GATES-22, THE FAST LANDING: only the targets and packages the change reaches, by the JUDGE's gates/fast.py.
if [ $fast = 1 ]; then
  # targets and crates were decided above, before the slot, on this same candidate
  if [ "$build" = 0 ]; then
    if grep -qE '^NO-BUILD:[[:space:]]*[^[:space:]]' "$msg"; then echo "  build: SKIPPED (NO-BUILD in message)"; note="$note (build skipped)"
    else echo "  build: --no-build needs a 'NO-BUILD: <reason>' message line"; fail="$fail no-build"; fi
  elif [ -n "$targets" ]; then
    echo "  build targets (reached): $targets (and the census modules)"
    # shellcheck disable=SC2086
    step build wrapped env -C "$G/tree" LEAN_NUM_THREADS="${LEAN_NUM_THREADS:-4}" lake build $targets +Census.Axioms +Census.Statements
  else
    echo "  build: none (no module, and no build input, changed)"
  fi
  decls_judge
  # GATES-20v (c): the axiom and statement census over the reach (a `native_decide` with no allow row, a `sorryAx`, a
  # vacuous disjunct red at the landing, not hours later), by the judge's census.py over main's Census (a fast
  # landing cannot change either: Census/ and gates/*.py are judge code). Plants are never a landing gate
  # (CHARTER's test clause): they run in the full judge and at convergence
  if [ -n "$targets" ] && [ "$build" = 1 ]; then
    case " $fail $killed " in
      *" build "*) echo "  census: SKIPPED (the build did not pass)" ;;
      *) step census wrapped python3 "$J/census.py" "$G/tree" --changed "$G/changed"
         grep -E '^census \(reach' "$G/step.out" | sed 's/^/  /' || true ;;
    esac
  fi
  # GATES-20y: the miscompiled string literal, read from the emitted C of the reach (every spelling)
  if [ -n "$targets" ] && [ "$build" = 1 ]; then
    case " $fail $killed " in *" build "*) ;; *) step cbytes python3 "$J/cbytes.py" scan "$G/tree" --changed "$G/changed" ;; esac
  fi
  case $crates in
    "") echo "  cargo: none (no workspace member changed)" ;;
    workspace)
      step cargo-check wrapped cargo check --quiet --locked --workspace --all-targets --manifest-path "$G/tree/Cargo.toml"
      step fmt wrapped cargo fmt --all --check --manifest-path "$G/tree/Cargo.toml" ;;
    *)
      pk=(); for c in $crates; do pk+=(-p "$c"); done
      echo "  cargo packages (reached): $crates"
      step cargo-check wrapped cargo check --quiet --locked "${pk[@]}" --all-targets --manifest-path "$G/tree/Cargo.toml"
      step fmt wrapped cargo fmt --check "${pk[@]}" --manifest-path "$G/tree/Cargo.toml" ;;
  esac
  short=${cand:0:12}
  if [ -n "$fail" ]; then
    echo "PRE-PUSH FAST RED tree $short:$fail — log: $log"
    grep -E '^  [a-z-]+: |error(\[E[0-9]+\])?:|^Diff in' "$log" | grep -v ': PRE-EXISTING ' | awk '!seen[$0]++' | head -40
    exit 1
  fi
  if [ -n "$killed" ]; then
    echo "PRE-PUSH NOT JUDGED tree $short:$killed — killed by a signal under memory pressure: not a verdict about this commit; re-run — log: $log"
    exit 76
  fi
  echo "PRE-PUSH FAST GREEN tree $short$note (built: ${targets:-none}; cargo: ${crates:-none}; the census over the reach: judged; the refine census, rows, benches, waste, generated files and clippy judge it at the next convergence)"
  exit 0
fi

# Every target, every time: lake's traces rebuild exactly what this tree changed (and anything a
# refused candidate left stale in this slot), so a hand-computed "affected" list could only ever
# build less. The census runs on every commit: a commit that changes only gates/axioms-allow.tsv
# must be censused too (it was not, and a stale allow row passed GREEN).
if [ "$build" = 0 ]; then
  if grep -qE '^NO-BUILD:[[:space:]]*[^[:space:]]' "$msg"; then echo "  build: SKIPPED (NO-BUILD in message)"; note="$note (build skipped)"
  else echo "  build: --no-build needs a 'NO-BUILD: <reason>' message line"; fail="$fail no-build"; fi
  decls_judge
else
  # shellcheck disable=SC2046
  step build wrapped env -C "$G/tree" LEAN_NUM_THREADS="${LEAN_NUM_THREADS:-4}" lake build $(lean_targets "$G/tree")
  if [ -n "$killed" ]; then echo "  census: SKIPPED (the build was killed)"
  else compute_keys; keyed_step census wrapped python3 "$G/tree/gates/census.py" "$G/tree"; fi
  [ -n "$killed" ] || decls_judge
  # GATES-20y: the miscompiled string literal, read from every module's emitted C
  case " $fail $killed " in *" build "*) ;; *) [ -n "$killed" ] || step cbytes python3 "$J/cbytes.py" scan "$G/tree" ;; esac
  # The verdict runs of every exe whose import closure holds a changed module (gates/runs.py,
  # gates/runs.tsv): a sim is a verdict a build cannot give (ROOT/HOSTING 10-17). Pending rows
  # (exit 3) do not block; a killed run is KILLED(load). A measured waste ratio above its ceiling
  # is red here already (unmeasured pinned rows are standing's: --partial).
  case " $fail $killed " in
    *" build "*) echo "  runs: SKIPPED (the build did not pass)" ;;
    *) judge_runs ;;
  esac
fi

# Generated files are checked on every commit: a Rust-only commit can make them stale too.
if [ "$build" = 1 ] && [ -z "$killed" ]; then
  while read -r exe out; do
    [ -n "$exe" ] && step "generated:$out" generated_check "$G/tree" "$exe" "$out"
  done < <(generated_checks "$G/tree")
fi

# The Rust workspace, judged whole when any member or the root manifest/lock changed: every member
# builds (all targets), clippy -D warnings, rustfmt, against the one root Cargo.lock (--locked: a
# commit that needs a lock change must carry it).
if [ "$(rust_changed "$base" "$cand")" = workspace ]; then
  [ -s "$G/keys" ] || compute_keys
  keyed_step cargo-check wrapped cargo check --quiet --locked --workspace --all-targets --manifest-path "$G/tree/Cargo.toml"
  keyed_step clippy wrapped cargo clippy --quiet --locked --workspace --all-targets --manifest-path "$G/tree/Cargo.toml" -- -D warnings
  keyed_step fmt wrapped cargo fmt --all --check --manifest-path "$G/tree/Cargo.toml"
fi

# The census and cargo steps' keys, re-checked at the end (the run keys were re-checked beside the runs).
if keyed && [ -s "$record" ]; then verify_keys --skip-runs; fi
short=${cand:0:12}
if [ -n "$fail" ]; then
  echo "PRE-PUSH RED tree $short:$fail — log: $log"
  # every gate's named reds (check.py prints `  <gate>: <red>`), once each, without PRE-EXISTING
  grep -E '^  [a-z-]+: |AXIOM-CENSUS red|^[^ ]+ \([^)]*\) uses |^allow row matches nothing|error:|^Diff in|^warning:|^  stale verdict:' "$log" | grep -v ': PRE-EXISTING ' | awk '!seen[$0]++' | head -40
  exit 1
fi
# Exit 76: not judged. scripts/commit says so and writes nothing; the lane re-runs it.
if [ -n "$killed" ]; then
  echo "PRE-PUSH NOT JUDGED tree $short:$killed — killed by a signal under memory pressure, or a run past its wall-clock deadline twice: not a verdict about this commit; re-run — log: $log"
  exit 76
fi
echo "PRE-PUSH GREEN tree $short$note"
