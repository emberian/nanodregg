#!/usr/bin/env bash
# scripts/commit — THE way to commit to nanodregg main (ROOT ruling 2026-10-16, after five
# stale-index incidents in one day: a commit built from a private or shared index read before
# someone else's commit silently reverted their files).
#
#   scripts/commit (-m MSG | -F FILE) [--cross-layer REASON] [--no-build REASON] PATH...
#
#  1. reads the CURRENT main into a private GIT_INDEX_FILE (never the shared index);
#  2. adds exactly PATH... from the working tree (a directory means every file under it;
#     a deleted file is recorded as deleted);
#  3. writes SIZE.md, a purely generated view, for that candidate (gates/size.py --write). SIZE.md
#     is refused as a PATH: ceilings are edited in gates/ceilings.tsv;
#  4. refuses if the candidate differs from main anywhere outside PATH... and SIZE.md;
#  5. runs scripts/pre-push on the candidate: ownership (the subject prefix `kernel:` … names the
#     layer, gates/OWNERS; --cross-layer records `CROSS-LAYER: REASON`), the source gates, the
#     build of the changed modules + every importer, the axiom census, cargo for changed crates
#     (--no-build records `NO-BUILD: REASON` and skips build + census);
#  6. commit-tree on main + compare-and-swap `update-ref refs/heads/main NEW BASE`: if main moved
#     while you were being judged, nothing is written and steps 1-6 re-run (COMMIT_RETRIES, 5);
#  7. leaves this worktree on the new main (`checkout --detach NEW`), moves the primary checkout
#     (the read-only reference) to it when that is clean, and pushes main to origin.
# Works from any worktree of the repo (scripts/worktree LAYER makes one).
#
# Detached landing (GATES-14): record the PID of scripts/commit ITSELF, not of a wrapping subshell:
#     nohup bash -c 'exec scripts/commit -m MSG PATH...' > LOG 2>&1 & echo $! > job.pid
# (`exec` makes $! the script's own PID; a bare `( ... ) &` records the subshell and orphans the
# judge, KERNEL-12). The attempt that judges is a re-exec of main's own copy; when
# NANODREGG_COMMIT_PID_FILE is set it writes ITS PID there. Never stop a judge by its PID file: a
# killed judge writes nothing and its slot is taken by flock until it exits. Wait for it, with a
# deadline, and read the log.
set -uo pipefail
. "$(dirname "$0")/gate-lib.sh"
# Every attempt runs main's OWN copy of scripts/commit and scripts/pre-push, materialized fresh
# from refs/heads/main: a worktree's scripts, OWNERS and gates may be behind main, and the
# parent's gates are the judge. A moved main (exit 75) re-reads main and re-runs, up to
# COMMIT_RETRIES (default 5) times.
if [ -z "${ND_COMMIT_ATTEMPT:-}" ]; then
  for attempt in $(seq 1 "${COMMIT_RETRIES:-5}"); do
    # A private copy per process: a running bash script must never be rewritten under it.
    M=$common/nanodregg-commit-main/$$
    rm -rf "$M"; materialize refs/heads/main "$M/tree" || exit 2
    if [ -x "$M/tree/scripts/commit" ]; then runner=$M/tree/scripts/commit; else runner=$0; fi
    out=$(ND_COMMIT_ATTEMPT=$attempt ND_COMMIT_SCRIPTS="$M/tree/scripts" "$runner" "$@" 2>&1); rc=$?
    printf '%s\n' "$out"
    rm -rf "$M" "$M/tree.index"
    [ $rc -eq 75 ] || exit $rc
    echo "scripts/commit: main moved (attempt $attempt); re-reading main"
  done
  echo "scripts/commit: main kept moving; gave up after ${COMMIT_RETRIES:-5} attempts"; exit 1
fi
scripts=${ND_COMMIT_SCRIPTS:-$(dirname "$0")}
[ -n "${NANODREGG_COMMIT_PID_FILE:-}" ] && echo $$ > "$NANODREGG_COMMIT_PID_FILE"
msgsrc="" msgfile="" cross="" nobuild=""
paths=()
while [ $# -gt 0 ]; do
  case $1 in
    -m) msgsrc=$2; shift ;;
    -F) msgfile=$2; shift ;;
    --cross-layer) cross=$2; shift ;;
    --no-build) nobuild=$2; shift ;;
    --) shift; paths+=("$@"); break ;;
    -*) echo "scripts/commit: unknown flag $1" >&2; exit 2 ;;
    *) paths+=("$1") ;;
  esac
  shift
done
[ ${#paths[@]} -gt 0 ] && { [ -n "$msgsrc" ] || [ -n "$msgfile" ]; } || {
  echo "usage: scripts/commit (-m MSG | -F FILE) [--cross-layer REASON] [--no-build REASON] PATH..." >&2; exit 2; }

tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
msg=$tmp/msg
if [ -n "$msgfile" ]; then cat "$msgfile" > "$msg"; else printf '%s\n' "$msgsrc" > "$msg"; fi
if [ -n "$cross" ] || [ -n "$nobuild" ]; then
  printf '\n' >> "$msg"
  [ -n "$cross" ] && printf 'CROSS-LAYER: %s\n' "$cross" >> "$msg"
  [ -n "$nobuild" ] && printf 'NO-BUILD: %s\n' "$nobuild" >> "$msg"
fi
grep -q '^Co-Authored-By:' "$msg" || printf '\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\n' >> "$msg"

base=$(git -C "$repo" rev-parse refs/heads/main) || exit 2
# Main lives in ONE clone (hbox, 10-17); every other clone is a reader that follows origin
# (scripts/mac-pull). The landing clone says so in its own config, which no pull can carry.
if [ "$(git -C "$repo" config --bool nanodregg.landing || true)" != true ]; then
  echo "scripts/commit: REFUSED — this clone is a reader; main lives on hbox: ssh hbox, cd /tank/dregg-build/nanodregg/wt/<layer>"; exit 1
fi
# Only a layer worktree, detached, commits. The primary checkout is the read-only reference
# (scouts, evaluators, `lake env lean` against its .lake), never an editing surface.
if [ "$repo" = "$(cd "$common/.." && pwd)" ]; then
  echo "scripts/commit: REFUSED — $repo is the primary checkout, the read-only reference; commit from a layer worktree (scripts/worktree LAYER)"; exit 1
fi
if git symbolic-ref -q HEAD > /dev/null; then
  echo "scripts/commit: REFUSED — this checkout is on branch $(git symbolic-ref --short HEAD); a layer worktree is detached at main: git checkout --detach main"; exit 1
fi
# The candidate is CURRENT main plus exactly PATH... as this worktree holds them. A path whose
# version at this worktree's HEAD differs from main's was edited on top of an older copy, and
# taking it would silently revert whatever main changed there since (051a8cc reverted KERNEL-4's
# 9e60d7f hunk in Protocol/Rows/Sim.lean exactly so). Refused by name, per file. `git checkout
# --detach main` carries an edit along when main did not change that file, and refuses when it did.
prefix=$(git rev-parse --show-prefix)
rel=(); for p in "${paths[@]}"; do r=$prefix${p#./}; rel+=("${r%/}"); done
for r in "${rel[@]}"; do
  if [ "$r" = SIZE.md ]; then
    echo "scripts/commit: REFUSED — SIZE.md is generated for every commit; edit ceilings in gates/ceilings.tsv"; exit 1
  fi
done
behind=$(git -C "$repo" diff --name-only HEAD "$base" -- "${rel[@]/#/:(top,literal)}") || exit 2
if [ -n "$behind" ]; then
  printf '%s\n' "$behind" | while read -r f; do
    echo "scripts/commit: REFUSED — worktree behind main on $f: git checkout --detach main, re-apply your edit"
  done
  exit 1
fi
idx=$tmp/index
export GIT_INDEX_FILE=$idx
git -C "$repo" read-tree "$base" || exit 2
# Paths are taken relative to the caller's directory, like git.
# A path gone from the working tree is recorded as deleted with `rm --cached` (plain `add -A`
# refuses a tracked file that .gitignore now lists, so such a file could never be untracked).
present=() gone=()
for p in "${paths[@]}"; do if [ -e "$p" ]; then present+=("$p"); else gone+=("$p"); fi; done
if [ ${#gone[@]} -gt 0 ]; then git rm -r -q --cached --ignore-unmatch -- "${gone[@]}" || exit 2; fi
if [ ${#present[@]} -gt 0 ]; then git add -A -- "${present[@]}" || exit 2; fi
# SIZE.md: the generated view of exactly this candidate, measured in a directory of this
# process's own (two commits judged at once must never measure each other's tree).
S=$tmp/size
materialize "$(git -C "$repo" write-tree)" "$S" || exit 2
python3 "$S/gates/size.py" "$S" --write > /dev/null || { echo "scripts/commit: gates/size.py --write failed"; exit 2; }
b=$(git -C "$repo" hash-object -w "$S/SIZE.md") && git -C "$repo" update-index --add --cacheinfo "100644,$b,SIZE.md"
cand=$(git -C "$repo" write-tree)

# Every changed path must be one you named.
prefixes=$(printf '%s\n' "${rel[@]}")
extra=$(git -C "$repo" diff --name-only "$base" "$cand" | while read -r f; do
  ok=0; [ "$f" = SIZE.md ] && ok=1
  while read -r p; do case $f in "$p"|"$p"/*) ok=1 ;; esac; done <<< "$prefixes"
  [ $ok = 1 ] || echo "$f"
done)
if [ -n "$extra" ]; then echo "scripts/commit: REFUSED — the candidate changes files you did not name:"; echo "$extra"; exit 1; fi
if git -C "$repo" diff --quiet "$base" "$cand"; then echo "scripts/commit: nothing to commit"; exit 1; fi
git -C "$repo" diff --stat "$base" "$cand"

pp=(--index --base "$base" --message "$msg"); [ -n "$nobuild" ] && pp+=(--no-build)
"$scripts/pre-push" "${pp[@]}"; rc=$?
if [ $rc -eq 76 ]; then echo "scripts/commit: NOT JUDGED — the judge was killed under load (KILLED(load)); nothing written: re-run scripts/commit"; exit 76; fi
[ $rc -eq 0 ] || { echo "scripts/commit: REFUSED by scripts/pre-push"; exit 1; }

new=$(git -C "$repo" commit-tree "$cand" -p "$base" -F "$msg") || exit 2
if ! git -C "$repo" update-ref refs/heads/main "$new" "$base"; then
  echo "scripts/commit: main moved while this commit was judged; nothing written."; exit 75
fi
unset GIT_INDEX_FILE
echo "scripts/commit: main = $(git -C "$repo" log --oneline -1 "$new")"
# Leave this worktree on the new main: point the landed paths' index entries at it (the working
# files already hold that content), take the landed (generated) SIZE.md, and check out the new
# commit, which carries other uncommitted edits along and refuses if one conflicts.
if ! { (cd "$repo" && git reset -q "$new" -- SIZE.md $(git diff --name-only "$base" "$new") 2>/dev/null)
       git -C "$repo" checkout -q "$new" -- SIZE.md
       git -C "$repo" checkout -q --detach "$new"; }; then
  echo "scripts/commit: landed, but this worktree could not move to $new (an uncommitted edit"
  echo "  conflicts with main); resolve it, then: git checkout --detach main"
fi
# The primary checkout is the read-only reference every scout and evaluator reads: it follows
# main, but only when clean (nobody edits it; a dirty file there is someone's to look at, and is
# never overwritten; an untracked file is not an edit, and checkout refuses to clobber one).
# ROOT 10-16, after it sat 87 commits behind for a day.
primary=$(cd "$common/.." && pwd)
dirty=$(git -C "$primary" status --porcelain --untracked-files=no 2>&1)
if [ -n "$dirty" ]; then
  echo "scripts/commit: WARNING the primary checkout $primary is dirty, left at $(git -C "$primary" rev-parse --short HEAD):"
  printf '%s\n' "$dirty" | head -20 | sed 's/^/  /'
elif git -C "$primary" symbolic-ref -q HEAD > /dev/null; then
  echo "scripts/commit: WARNING the primary checkout $primary is on a branch; the reference is detached: git -C $primary checkout --detach main"
elif ! git -C "$primary" checkout -q --detach "$new"; then
  echo "scripts/commit: WARNING the primary checkout $primary could not move to $new"
fi
# origin (github.com/emberian/nanodregg) follows main. A failed push leaves the landing standing
# (the next landing pushes it too); a rejected one usually means a later landing pushed first.
if git -C "$repo" remote get-url origin > /dev/null 2>&1; then
  if GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=20" git -C "$repo" push -q origin "$new:refs/heads/main" 2>"$tmp/push"; then
    echo "scripts/commit: pushed $(git -C "$repo" rev-parse --short "$new") to origin"
  else
    echo "scripts/commit: WARNING push to origin failed (landed on main all the same):"; sed 's/^/  /' "$tmp/push"
  fi
fi
